# Raw CRMLS data — never commit
data/
*.csv
# Small metric tables are part of the results and are tracked
!results/*.csv

# Fitted models are rebuilt from the notebooks (the Week 5 forest is ~250 MB)
# and by python -m src.train (the app model)
models/**/*.joblib

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# macOS
.DS_Store

# Jupyter temporary files
.ipynb_checkpoints/

# Per-home predictions contain licensed CRMLS sale records; keep them local
results/march_predictions.csv
results/april_predictions.csv
