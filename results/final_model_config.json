{
  "model": "XGBoost",
  "params": {
    "learning_rate": 0.1,
    "max_depth": 10,
    "n_estimators": 500,
    "min_child_weight": 20
  },
  "log_target": true,
  "features": {
    "name": "B without ratios",
    "numeric": [
      "LivingArea",
      "LotSizeSquareFeet",
      "BedroomsTotal",
      "BathroomsTotalInteger",
      "AgeAtSale",
      "Latitude",
      "Longitude"
    ],
    "categorical": [
      "City",
      "PostalCode",
      "SchoolDistrict"
    ]
  }
}
